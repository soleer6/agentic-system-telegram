# Copia este archivo a .env y rellénalo. Nunca subas .env a GitHub.

# Token del bot: créalo hablando con @BotFather en Telegram (/newbot).
TELEGRAM_TOKEN=
# Tu ID numérico de Telegram (pídeselo a @userinfobot). El bot SOLO responde a este usuario.
TELEGRAM_USER_ID=

# Opcionales: modelos gratuitos de reserva y para tareas simples (/gratis). Cuentas gratuitas, sin tarjeta.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Opcional: equipo de Vercel para /vercel (si no, usa la cuenta con sesión iniciada en la CLI).
VERCEL_SCOPE=
